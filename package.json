{
  "name": "korume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:c4": "playwright test --config=playwright.c4.config.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "verify:db:lesson-jobs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-lesson-creation-gate.ps1",
    "verify:db:settings": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-settings-gate.ps1",
    "verify:db:pronunciation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-pronunciation-gate.ps1",
    "verify:db:shadowing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-shadowing-gate.ps1",
    "verify:db:dictionary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-dictionary-gate.ps1",
    "dict:import": "vite-node --config vitest.config.ts scripts/import-dictionaries.ts --",
    "dict:gc": "vite-node --config vitest.config.ts scripts/dictionary-gc.ts --",
    "verify:protocol": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-codex-protocol.ps1",
    "verify:protocol:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-codex-protocol.test.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.11.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "gsap": "^3.12.5",
    "kuromoji": "^0.1.2",
    "lenis": "^1.1.13",
    "next": "14.2.35",
    "next-intl": "^4.13.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.2",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.15",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint": "^8.56.12",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
