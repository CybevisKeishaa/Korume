// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AnswerBlocks > renders a v1 answer exactly as before 1`] = `"<div class="flex flex-col gap-md text-body-lg"><p class="text-foreground/90">Use <span lang="ja" class="mx-2xs rounded-sm bg-primary/10 px-2xs font-jp text-primary-strong">は</span><strong class="font-semibold text-foreground">bold</strong></p><figure class="rounded-lg border border-primary/15 bg-primary/5 px-md py-sm"><div class="flex flex-wrap items-baseline gap-x-sm gap-y-2xs"><span class="font-jp text-body-lg text-foreground" lang="ja"><span>私は学生です</span></span></div><figcaption class="mt-2xs text-caption text-muted-foreground">I am a student</figcaption></figure><ul aria-label="Suggested questions" class="flex flex-wrap gap-xs"><li><button type="button" disabled="" class="min-h-hit-target rounded-full border border-primary/20 bg-primary/10 px-sm text-caption font-medium text-primary-strong hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-60">Why?</button></li></ul></div>"`;
