# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env (never commit secrets — CLAUDE.md §6)
# Broad match on purpose: every .env variant is ignored; only the
# placeholder-only example file is whitelisted back in.
.env
.env.*
!.env.local.example

# personal/local tool state (machine paths, per-user permissions, sessions)
.claude/settings.local.json
.vscode/
.idea/

# keys / certificates — belt & suspenders (*.pem already above)
*.key
*.p12
*.pfx

# user voice recordings / personal data exports must never enter the repo
# (CLAUDE.md §2 — they live in Supabase Storage, encrypted, user-owned)
/recordings/
/exports/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript / next
next-env.d.ts
*.tsbuildinfo

# supabase local
/supabase/.branches
/supabase/.temp

# subagent-driven-development scratch workspace (ledgers, briefs, review packages)
/.superpowers/
*.blend1
