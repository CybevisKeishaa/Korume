# Copy to .env.local and fill in. NEVER commit .env.local (CLAUDE.md §6).

# --- Startup validation (lib/env/validate.ts, instrumentation.ts) ---
# These three are validated once at boot, before the app serves its first
# request. Misconfiguration fails startup with an aggregated error instead of
# surfacing as a runtime 503 on whichever route happens to need it.

# Deployment environment. Required, never inferred: `next build` is NODE_ENV=production
# even on a laptop, so NODE_ENV cannot express this. Also gates PayOS sandbox vs live (L8).
APP_ENV=dev

# Which AI provider to use. Required. `none` = intentionally disabled (features return 503).
# `gemini` is DEV ONLY — its free tier permits training on submitted data, so it must never
# see real user data (CLAUDE.md §2). APP_ENV=production + gemini fails at startup.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL_FAST=
# GEMINI_MODEL_DEEP=

# Which speech provider to use. Required. `none` = intentionally disabled (503).
SPEECH_PROVIDER=none

# --- Supabase (Project Settings → API) ---
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only — NEVER expose to the client. Used for admin/migration tasks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Postgres connection string (Project Settings → Database → Connection string).
# Used by the Supabase CLI / migrations only.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- Third-party keys (keep server-only) ---
# Layer 4 — AI features. Selection and requiredness are governed by AI_PROVIDER
# and SPEECH_PROVIDER above (validated at startup); these hold the actual
# credentials once a provider is selected.
# Claude chatbot, video summaries, example sentences (console.anthropic.com):
# ANTHROPIC_API_KEY=""
# Azure Speech: pronunciation assessment (JA), STT, TTS reference audio.
# Leave empty until you register a key (portal.azure.com → Speech service).
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# GEMINI_API_KEY=""
# GEMINI_MODEL_FAST=""
# GEMINI_MODEL_DEEP=""

# --- Layer 7: Admin CMS ---
# Bootstrap-only allowlist for the first admin account(s), comma-separated,
# case-insensitive (e.g. "founder@example.com, ops@example.com"). The source
# of truth is users.is_admin in the DB — this env var only lets a matching
# signed-in user's row be promoted to is_admin=true the first time they call
# an admin endpoint (see lib/admin/guard.ts). Leave empty once every admin
# you need has been bootstrapped; the DB flag keeps working regardless.
ADMIN_EMAILS=""

# --- Layer 8: Billing (PayOS) ---
# PayOS is the payment provider — Stripe is ruled out, it cannot officially
# receive from VN payers (docs/product/business-model.md §0). Server-only:
# these are signing/auth credentials, NEVER expose them to the client.
# From the PayOS merchant dashboard (my.payos.vn → Kênh thanh toán → API):
# APP_ENV above gates sandbox vs live, so these hold whichever set matches it.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
# Verifies webhook signatures — a leak lets anyone forge "payment succeeded".
PAYOS_CHECKSUM_KEY=""

# --- Scheduler (lib/scheduler) ---
# Off unless set to the literal string "true" — never inferred from APP_ENV
# or NODE_ENV, so a build step can never delete anybody's account. Unset (the
# default) means: account-deletion requests are still recorded, but nothing
# ever executes them — grace periods elapse and nothing happens until an
# operator opts in explicitly.
#
# VALIDATED AT STARTUP (lib/scheduler/env.ts): the only accepted values are
# the exact strings "true" and "false", or unset. "1", "TRUE" and "yes" are
# REJECTED and fail startup rather than being read as "off" — a near-miss used
# to disable every account deletion silently while the app kept telling users
# a date. The disabled path also logs one line, so "off" is observable.
# SCHEDULER_ENABLED="true"

# --- Later layers ---
# YOUTUBE_DATA_API_KEY=""
